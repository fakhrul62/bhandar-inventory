generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
}

enum PlanName {
  FREE
  PRO
  MAX
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum Currency {
  BDT
  USD
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  BKASH
  NAGAD
  DEV_MOBILE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
  NONE
}

model User {
  id            String          @id @db.Uuid
  email         String          @unique
  name          String?
  avatarUrl     String?
  role          UserRole        @default(OWNER)
  planId        String
  createdAt     DateTime        @default(now())
  stores        Store[]
  plan          Plan            @relation(fields: [planId], references: [id])
  subscription  Subscription?

  @@index([planId])
}

model Plan {
  id            String          @id @default(cuid())
  name          PlanName        @unique
  price         Int
  productLimit  Int
  users         User[]
  subscriptions Subscription[]
}

model Store {
  id          String    @id @default(cuid())
  userId      String    @db.Uuid
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  orders      Order[]

  @@index([userId])
  @@index([slug])
}

model Product {
  id          String           @id @default(cuid())
  storeId     String
  name        String
  description String?
  type        ProductType
  price       Decimal          @db.Decimal(12, 2)
  currency    Currency         @default(BDT)
  stock       Int?
  imageUrls   String[]
  fileUrl     String?
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  orderItems  OrderItem[]

  @@index([storeId])
  @@index([type])
  @@index([isPublished])
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  label           String
  value           String
  additionalPrice Decimal     @default(0) @db.Decimal(12, 2)
  stock           Int?
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([productId])
}

model Order {
  id            String        @id @default(cuid())
  storeId       String
  buyerEmail    String
  buyerName     String
  buyerPhone    String
  buyerAddress  String        @default("")
  deliveryNote  String?
  locationLat   Float?
  locationLng   Float?
  totalAmount   Decimal       @db.Decimal(12, 2)
  currency      Currency      @default(BDT)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentRef    String?
  createdAt     DateTime      @default(now())
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @db.Uuid
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  planId               String
  status               SubscriptionStatus @default(NONE)
  currentPeriodEnd     DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([planId])
}
